        "https://localhost:9001",
        "http://localhost:9000",
        "https://www.voyagevibes.in:9001",
        "http://www.voyagevibes.in:9000",
        "https://voyagevibes.in:9001",
        "http://voyagevibes.in:9000",
        "https://customer-ui.voyagevibes.in:9001",
        "http://customer-ui.voyagevibes.in:9000"
      ]
    },
    {
      "clientId": "flight-auth-admin",
      "name": "VoyageVibes Auth Administration",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CorpWebSecret123$",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
