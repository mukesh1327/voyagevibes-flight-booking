      {
        "name": "corporate"
      },
      {
        "name": "flight-admin"
      },
      {
        "name": "support-desk"
      },
      {
        "name": "booking-ops"
      },
      {
        "name": "finance-ops"
      },
      {
        "name": "platform-admin"
      },
      {
        "name": "super-admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "flight-auth-service",
      "name": "VoyageVibes Auth Service",
