FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/FlightService/FlightService.csproj src/FlightService/
RUN dotnet restore src/FlightService/FlightService.csproj
COPY src/FlightService src/FlightService
RUN dotnet publish src/FlightService/FlightService.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0

ARG OTEL_DOTNET_AUTO_INSTALL_URL=https://github.com/open-telemetry/opentelemetry-dotnet-instrumentation/releases/latest/download/otel-dotnet-auto-install.sh

ENV OTEL_DOTNET_AUTO_HOME=/otel/dotnet-auto

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl unzip \
    && mkdir -p "${OTEL_DOTNET_AUTO_HOME}" \
    && curl --fail --location --silent --show-error "${OTEL_DOTNET_AUTO_INSTALL_URL}" --output /tmp/otel-dotnet-auto-install.sh \
    && sh /tmp/otel-dotnet-auto-install.sh \
    && rm -rf /var/lib/apt/lists/* /tmp/otel-dotnet-auto-install.sh

WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8083
ENTRYPOINT ["dotnet", "FlightService.dll"]
