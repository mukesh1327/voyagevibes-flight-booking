FROM docker.io/library/node:22-alpine AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM docker.io/library/nginx:1.27-alpine

# Build the Vite bundle in the image so a prebuilt local dist directory is not required.
COPY --from=build /workspace/dist/. /opt/app-root/src/

# Load logging and HTTPS server config at nginx http context.
COPY ./docker/nginx/01-logging.conf /etc/nginx/conf.d/01-logging.conf
COPY ./docker/nginx/02-customer-ui-https.conf /etc/nginx/conf.d/02-customer-ui-https.conf

RUN rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /opt/app-root/src/logs/nginx

EXPOSE 9000 9001

CMD ["nginx", "-g", "daemon off;"]
