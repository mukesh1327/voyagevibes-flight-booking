{
  "id": "flight-booking",
  "realm": "flight-booking",
  "enabled": true,
  "displayName": "Flight Booking Identity",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Flight Booking Identity</span></div>",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins"
  ],
  "defaultOptionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ],
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Base role for self-service customer sessions."
      },
      {
        "name": "corporate",
        "description": "Base role for workforce sessions."
      },
      {
        "name": "admin",
        "description": "Application admin role used for privileged auth-service operations."
      },
      {
        "name": "support-desk",
        "description": "Customer support workforce role for payment, refund, and booking queries."
      },
      {
        "name": "booking-ops",
        "description": "Operations workforce role for itinerary changes, reissues, and cancellations."
      },
      {
        "name": "finance-ops",
        "description": "Finance workforce role for reconciliation, refunds, and chargeback review."
      },
      {
        "name": "flight-admin",
        "description": "Operational role for schedules, routes, and flight inventory updates."
      },
      {
        "name": "pricing-analyst",
        "description": "Read-heavy role for pricing and campaign analysis."
      },
      {
        "name": "corporate-travel-manager",
        "description": "B2B workforce role for enterprise account support."
      },
      {
        "name": "reporting-analyst",
        "description": "Read-only reporting and audit role."
      },
      {
        "name": "super-admin",
        "description": "Privileged platform administration role."
      }
    ]
  },
  "groups": [
    {
      "name": "customers",
      "description": "Customer identities brokered from Google or another approved customer IdP.",
      "realmRoles": [
        "customer"
      ]
    },
    {
      "name": "corporate-users",
      "description": "Corporate workforce users managed through SSO, LDAP, or admin assignment.",
      "subGroups": [
        {
          "name": "support-desk",
          "description": "Workforce group for support-desk agents.",
          "realmRoles": [
            "corporate",
            "support-desk"
          ]
        },
        {
          "name": "booking-ops",
          "description": "Workforce group for booking operations.",
          "realmRoles": [
            "corporate",
            "booking-ops"
          ]
        },
        {
          "name": "finance-ops",
          "description": "Workforce group for finance operations.",
          "realmRoles": [
            "corporate",
            "finance-ops"
          ]
        },
        {
          "name": "flight-admin",
          "description": "Workforce group for flight operations administrators.",
          "realmRoles": [
            "corporate",
            "flight-admin"
          ]
        },
        {
          "name": "pricing-analyst",
          "description": "Workforce group for pricing analysts.",
          "realmRoles": [
            "corporate",
            "pricing-analyst"
          ]
        },
        {
          "name": "corporate-travel-manager",
          "description": "Workforce group for enterprise account managers.",
          "realmRoles": [
            "corporate",
            "corporate-travel-manager"
          ]
        },
        {
          "name": "reporting-analyst",
          "description": "Workforce group for reporting analysts.",
          "realmRoles": [
            "corporate",
            "reporting-analyst"
          ]
        },
        {
          "name": "super-admin",
          "description": "Workforce group for privileged platform admins.",
          "realmRoles": [
            "corporate",
            "admin",
            "super-admin"
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "flight-auth-service",
      "name": "Flight Auth Service",
      "description": "Confidential OIDC client used by the auth service for authorization-code exchange and service-account operations.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": true,
      "secret": "replace-with-client-secret",
      "rootUrl": "https://auth.voyagevibes.in",
      "baseUrl": "https://auth.voyagevibes.in",
      "adminUrl": "https://auth.voyagevibes.in",
      "redirectUris": [
        "http://localhost:8081/swagger-ui/oauth2-redirect.html",
        "https://auth.voyagevibes.in/swagger-ui/oauth2-redirect.html",
        "https://app.voyagevibes.in/*",
        "https://staff.voyagevibes.in/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "https://app.voyagevibes.in",
        "https://staff.voyagevibes.in"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "flight-auth-admin",
      "name": "Flight Auth Admin",
      "description": "Confidential client used by the auth service for introspection and Keycloak admin API calls.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "secret": "replace-with-admin-client-secret",
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-customers-group",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-group-idp-mapper",
      "config": {
        "group": "/customers"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-flight-auth-admin",
      "enabled": true,
      "serviceAccountClientId": "flight-auth-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-users"
        ]
      }
    }
  ]
}
